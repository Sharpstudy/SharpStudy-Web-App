		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.64.0",
		"@types/bcrypt": "^6.0.0",
		"@types/jsonwebtoken": "^8",
		"@types/node": "^20",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^18",
		"dotenv": "^18.0.7",
		"env-cmd": "^10.1.0",
		"eslint": "8.20.0",
