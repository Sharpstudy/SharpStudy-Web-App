{
	"name": "SharpStudy",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"model:generate": "env-cmd sequelize-cli model:generate",
		"seed:generate": "env-cmd sequelize-cli seed:generate",
		"seed": "env-cmd sequelize-cli db:seed:all",
		"migrate": "env-cmd sequelize-cli db:migrate",
		"migrate:rollback": "env-cmd sequelize-cli db:migrate:undo",
		"migrate:rollback:all": "env-cmd sequelize-cli db:migrate:undo:all",
		"lt:seed": "vite-node --config vitest.config.mts learn-together/scripts/seed.ts",
		"lt:typecheck": "tsc --noEmit -p tsconfig.json",
		"lt:lint": "next lint --dir learn-together --dir pages/learn --dir pages/api/learn",
		"lt:test": "vitest run",
		"lt:e2e": "playwright test -c tests/learn-together/e2e/playwright.config.ts"
	},
	"dependencies": {
		"@emotion/react": "^11.10.5",
		"@etchteam/next-pagination": "^3.5.4",
		"@mantine/core": "^5.10.1",
		"@mantine/hooks": "^5.10.1",
		"@mantine/rte": "^5.1.1",
		"ably": "^2",
		"axios": "^0.27.2",
		"bcrypt": "^5.0.1",
		"disqus-react": "^1.1.5",
		"framer-motion": "^7.3.4",
		"fslightbox-react": "^1.6.2-2",
		"html-to-image": "^1.10.8",
		"js-cookie": "^3.0.1",
		"jsonwebtoken": "^8.5.1",
		"jspdf": "^2.5.1",
		"mysql2": "^2.3.3",
		"next": "^12.3.0",
		"next-swagger-doc": "^0.4.0",
		"nodemailer": "^6.7.7",
		"nookies": "^2.5.2",
		"nprogress": "^0.2.0",
		"qrcode": "^1.5.4",
		"react": "18.2.0",
		"react-accessible-accordion": "^5.0.0",
		"react-confirm-alert": "^3.0.6",
		"react-dom": "18.2.0",
		"react-hot-toast": "^2.3.0",
		"react-jutsu": "^3.0.3",
		"react-loading-skeleton": "^3.1.0",
		"react-redux": "^8.0.2",
		"react-sticky-box": "^1.0.2",
		"react-stripe-checkout": "^2.6.3",
		"react-tabs": "^5.1.0",
		"redux": "^4.2.0",
		"redux-devtools-extension": "^2.13.9",
		"redux-thunk": "^2.4.1",
		"sass": "^1.54.0",
		"sequelize": "^6.21.3",
		"stripe": "^10.2.0",
		"swagger-ui": "^5.11.2",
		"swagger-ui-react": "^5.11.3",
		"swiper": "^8.3.2",
		"uuid": "^8.3.2",
