{
  "openapi": "3.0.0",
  "info": {
    "title": "Sharpstudy API",
    "description": "Description of your API",
    "version": "1.0.0",
    "contact": {
      "name": "Sharpstudy",
      "email": "hello@sharpstudy.io"
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  },
  "paths": {
    "/api/users": {
      "get": {
        "summary": "Retrieve a list of users",
        "description": "Returns a list of users.",
        "responses": {
          "200": {
            "description": "A list of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new user",
        "description": "Creates a new user.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/signup": {
      "post": {
        "summary": "Sign up a new user",
        "description": "Signs up a new user with first name, last name, email, and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "first_name": {
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "first_name",
                  "last_name",
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User signed up successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/signin": {
      "post": {
        "summary": "Signin existing user",
        "description": "Signin user with email, and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User signed in successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "summary": "Retrieve a list of categories",
        "description": "Returns a list of categories.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "A list of categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/partners": {
      "get": {
        "summary": "Retrieve a list of partners",
        "description": "Returns a list of partners.",
        "responses": {
          "200": {
            "description": "A list of partners",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Partner"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new partner",
        "description": "Creates a new partner.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Partner"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Partner created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Partner"
                }
              }
            }
          }
        }
      }
    },
    "/api/all-courses": {
      "get": {
        "summary": "Get a list of courses",
        "description": "Retrieve a list of courses with optional pagination, sorting, and search functionality.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "The page number for pagination.",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "The number of items per page for pagination.",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "short",
            "in": "query",
            "description": "Short field for sorting.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search query for filtering courses.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseList"
                }
              }
            }
          },
          "404": {
            "description": "No courses found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/courses/new": {
      "post": {
        "summary": "Create a new course",
        "description": "Endpoint to create a new course.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "Title of the course."
                  },
                  "short_desc": {
                    "type": "string",
                    "description": "Short description of the course."
                  },
                  "overview": {
                    "type": "string",
                    "description": "Overview of the course."
                  },
                  "latest_price": {
                    "type": "number",
                    "description": "Latest price of the course."
                  },
                  "before_price": {
                    "type": "number",
                    "description": "Previous price of the course."
                  },
                  "lessons": {
                    "type": "string",
                    "description": "Number of lessons in the course."
                  },
                  "duration": {
                    "type": "string",
                    "description": "Duration of the course."
                  },
                  "image": {
                    "type": "string",
                    "format": "url",
                    "description": "URL of the course image."
                  },
                  "access_time": {
                    "type": "string",
                    "description": "Access time of the course."
                  },
                  "requirements": {
                    "type": "string",
                    "description": "Requirements for the course."
                  },
                  "what_you_will_learn": {
                    "type": "string",
                    "description": "What you will learn in the course."
                  },
                  "who_is_this_course_for": {
                    "type": "string",
                    "description": "Target audience of the course."
                  },
                  "catId": {
                    "type": "string",
                    "description": "ID of the category the course belongs to."
                  },
                  "is_class": {
                    "type": "boolean",
                    "description": "Whether the course is a class or not."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Course created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Success message."
                    },
                    "course": {
                      "$ref": "#/components/schemas/Course"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request, invalid parameters."
          },
          "500": {
            "description": "Internal server error, failed to create the course."
          }
        }
      }
    },
    "/api/courses/course/upload/new": {
      "post": {
        "summary": "Upload a new video course",
        "description": "Endpoint to upload a new video course.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "group_name": {
                    "type": "string",
                    "description": "Group name of the video."
                  },
                  "title": {
                    "type": "string",
                    "description": "Title of the video course."
                  },
                  "thumb": {
                    "type": "string",
                    "format": "url",
                    "description": "URL of the thumbnail image for the video."
                  },
                  "video": {
                    "type": "string",
                    "format": "url",
                    "description": "URL of the video file."
                  },
                  "video_length": {
                    "type": "number",
                    "description": "Length of the video in seconds."
                  },
                  "is_preview": {
                    "type": "boolean",
                    "description": "Indicates if the video is a preview."
                  },
                  "short_id": {
                    "type": "number",
                    "description": "Short identifier for the video."
                  },
                  "courseId": {
                    "type": "string",
                    "description": "ID of the course associated with the video."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Video course uploaded successfully."
          },
          "400": {
            "description": "Bad request, invalid parameters."
          },
          "401": {
            "description": "Unauthorized, authentication required."
          },
          "500": {
            "description": "Internal server error, failed to upload the video course."
          }
        }
      }
    },
    "/api/admin/courses/requests": {
      "put": {
        "summary": "Update course approval status",
        "description": "Endpoint to update the approval status of a course.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "courseId": {
                    "type": "string",
                    "description": "ID of the course to be updated."
                  },
                  "approved": {
                    "type": "boolean",
                    "description": "Boolean indicating whether the course is approved or not."
                  }
                },
                "required": [
                  "courseId",
                  "approved"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Course approval status updated successfully."
          },
          "400": {
            "description": "Bad request, invalid parameters."
          },
          "401": {
            "description": "Unauthorized, authentication required."
          },
          "500": {
            "description": "Internal server error, failed to update course approval status."
          }
        }
      }
    },
    "/api/instructor/requests": {
      "put": {
        "summary": "Approve or reject an instructor request as an Admin",
        "description": "Endpoint to approve or reject an instructor request.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "instId": {
                    "type": "string",
                    "description": "ID of the instructor request to approve or reject."
                  },
                  "approve": {
                    "type": "boolean",
                    "description": "Boolean indicating whether to approve or reject the instructor request."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Instructor request approved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Success message indicating the approval of the instructor request."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request, invalid parameters."
          },
          "401": {
            "description": "Unauthorized, authentication required."
          },
          "500": {
            "description": "Internal server error, failed to approve the instructor request."
          }
        }
      }
    },
    "/api/admin/courses": {
      "get": {
        "summary": "Get instructor courses",
        "description": "Endpoint to fetch courses associated with a particular instructor.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Courses fetched successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Course"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized, authentication required."
          },
          "500": {
            "description": "Internal server error, failed to fetch courses."
          }
        }
      }
    },
    "/api/instructor/new": {
      "put": {
        "summary": "Submit a new instructor request",
        "description": "Endpoint to submit a new request to become an instructor.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Name of the instructor."
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email address of the instructor."
                  },
                  "phone": {
                    "type": "string",
                    "description": "Phone number of the instructor."
                  },
                  "instructor_subject": {
                    "type": "string",
                    "description": "Subject for which the instructor is applying."
                  },
                  "instructor_description": {
                    "type": "string",
                    "description": "Description or reason for applying to become an instructor."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request received successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Message confirming the request submission."
                    },
                    "instructor": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "description": "ID of the newly created instructor request."
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request, invalid parameters."
          },
          "500": {
            "description": "Internal server error, failed to submit the request."
          }
        }
      }
    },
    "/api/instructor/instructors": {
      "get": {
        "summary": "Get list of approved instructors",
        "description": "Retrieve a list of all approved instructors.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Instructors"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "gender": {
            "type": "string"
          },
          "designation": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "profile_photo": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "reset_password_token": {
            "type": "string",
            "format": "uuid"
          },
          "reset_password_send_at": {
            "type": "string",
            "format": "date-time"
          },
          "reset_password_at": {
            "type": "string",
            "format": "date-time"
          },
          "website": {
            "type": "string",
            "format": "uri"
          },
          "twitter": {
            "type": "string",
            "format": "uri"
          },
          "facebook": {
            "type": "string",
            "format": "uri"
          },
          "linkedin": {
            "type": "string",
            "format": "uri"
          },
          "youtube": {
            "type": "string",
            "format": "uri"
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "admin",
              "instructor"
            ]
          },
          "email_confirmed": {
            "type": "boolean"
          },
          "email_confirmed_at": {
            "type": "string",
            "format": "date-time"
          },
          "instructor_request": {
            "type": "boolean"
          },
          "instructor_request_confirmed": {
            "type": "boolean"
          },
          "instructor_request_confirmed_at": {
            "type": "string",
            "format": "date-time"
          },
          "instructor_status": {
            "type": "boolean"
          },
          "instructor_subject": {
            "type": "string"
          },
          "instructor_description": {
            "type": "string"
          },
          "status": {
            "type": "boolean"
          },
          "is_profile_public": {
            "type": "boolean"
          }
        },
        "required": [
          "first_name",
          "last_name",
          "email",
          "password",
          "role",
          "status"
        ]
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Partner": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "partner_image": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "partner_image"
        ]
      },
      "CourseList": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Course"
            }
          },
          "totalPages": {
            "type": "integer"
          },
          "coursesCount": {
            "type": "integer"
          }
        }
      },
      "Course": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "short_desc": {
            "type": "string"
          },
          "overview": {
            "type": "string"
          },
          "latest_price": {
            "type": "number"
          },
          "before_price": {
            "type": "number"
          },
          "lessons": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "access_time": {
            "type": "string",
            "enum": [
              "Lifetime",
              "Three Months",
              "Six Months",
              "1 Year"
            ]
          },
          "requirements": {
            "type": "string"
          },
          "what_you_will_learn": {
            "type": "string"
          },
          "who_is_this_course_for": {
            "type": "string"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "catId": {
            "type": "string",
            "format": "uuid"
          },
          "approved": {
            "type": "boolean"
          },
          "in_home_page": {
            "type": "boolean"
          },
          "in_home_page_set_at": {
            "type": "string",
            "format": "date-time"
          },
          "is_class": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "short_desc",
          "overview",
          "latest_price",
          "before_price",
          "lessons",
          "duration",
          "image",
          "access_time",
          "requirements",
          "what_you_will_learn",
          "who_is_this_course_for",
          "userId",
          "catId",
          "approved",
          "in_home_page",
          "is_class"
        ]
      }
    }
  }
}