{
  "openapi": "3.0.0",
  "info": {
    "title": "Sharpstudy API",
    "description": "Description of your API",
    "version": "1.0.0",
    "contact": {
      "name": "Sharpstudy",
      "email": "hello@sharpstudy.io"
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  },
  "paths": {
    "/api/users": {
      "get": {
        "summary": "Retrieve a list of users",
        "description": "Returns a list of users.",
        "responses": {
          "200": {
            "description": "A list of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new user",
        "description": "Creates a new user.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/signup": {
      "post": {
        "summary": "Sign up a new user",
        "description": "Signs up a new user with first name, last name, email, and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "first_name": {
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "first_name",
                  "last_name",
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User signed up successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/signin": {
      "post": {
        "summary": "Signin existing user",
        "description": "Signin user with email, and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User signed in successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "summary": "Retrieve a list of categories",
        "description": "Returns a list of categories.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "A list of categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/partners": {
      "get": {
        "summary": "Retrieve a list of partners",
        "description": "Returns a list of partners.",
        "responses": {
          "200": {
            "description": "A list of partners",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Partner"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new partner",
        "description": "Creates a new partner.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Partner"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Partner created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Partner"
                }
              }
            }
          }
        }
      }
    },
    "/api/all-courses": {
      "get": {
        "summary": "Get a list of courses",
        "description": "Retrieve a list of courses with optional pagination, sorting, and search functionality.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "The page number for pagination.",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "The number of items per page for pagination.",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "short",
            "in": "query",
            "description": "Short field for sorting.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search query for filtering courses.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseList"
                }
              }
            }
          },
          "404": {
            "description": "No courses found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          },
          "gender": {
            "type": "string"
          },
          "designation": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "profile_photo": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "reset_password_token": {
            "type": "string",
            "format": "uuid"
          },
          "reset_password_send_at": {
            "type": "string",
            "format": "date-time"
          },
          "reset_password_at": {
            "type": "string",
            "format": "date-time"
          },
          "website": {
            "type": "string",
            "format": "uri"
          },
          "twitter": {
            "type": "string",
            "format": "uri"
          },
          "facebook": {
            "type": "string",
            "format": "uri"
          },
          "linkedin": {
            "type": "string",
            "format": "uri"
          },
          "youtube": {
            "type": "string",
            "format": "uri"
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "admin",
              "instructor"
            ]
          },
          "email_confirmed": {
            "type": "boolean"
          },
          "email_confirmed_at": {
            "type": "string",
            "format": "date-time"
          },
          "instructor_request": {
            "type": "boolean"
          },
          "instructor_request_confirmed": {
            "type": "boolean"
          },
          "instructor_request_confirmed_at": {
            "type": "string",
            "format": "date-time"
          },
          "instructor_status": {
            "type": "boolean"
          },
          "instructor_subject": {
            "type": "string"
          },
          "instructor_description": {
            "type": "string"
          },
          "status": {
            "type": "boolean"
          },
          "is_profile_public": {
            "type": "boolean"
          }
        },
        "required": [
          "first_name",
          "last_name",
          "email",
          "password",
          "role",
          "status"
        ]
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Partner": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "partner_image": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "partner_image"
        ]
      },
      "CourseList": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Course"
            }
          },
          "totalPages": {
            "type": "integer"
          },
          "coursesCount": {
            "type": "integer"
          }
        }
      },
      "Course": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "short_desc": {
            "type": "string"
          },
          "overview": {
            "type": "string"
          },
          "latest_price": {
            "type": "number"
          },
          "before_price": {
            "type": "number"
          },
          "lessons": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "access_time": {
            "type": "string",
            "enum": [
              "Lifetime",
              "Three Months",
              "Six Months",
              "1 Year"
            ]
          },
          "requirements": {
            "type": "string"
          },
          "what_you_will_learn": {
            "type": "string"
          },
          "who_is_this_course_for": {
            "type": "string"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "catId": {
            "type": "string",
            "format": "uuid"
          },
          "approved": {
            "type": "boolean"
          },
          "in_home_page": {
            "type": "boolean"
          },
          "in_home_page_set_at": {
            "type": "string",
            "format": "date-time"
          },
          "is_class": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "short_desc",
          "overview",
          "latest_price",
          "before_price",
          "lessons",
          "duration",
          "image",
          "access_time",
          "requirements",
          "what_you_will_learn",
          "who_is_this_course_for",
          "userId",
          "catId",
          "approved",
          "in_home_page",
          "is_class"
        ]
      }
    }
  }
}